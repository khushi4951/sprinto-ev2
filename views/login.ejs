<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="auth-mode">
    <main class="main" style="min-height:100vh; display:grid; place-items:center;">
      <section class="auth__panel" style="max-width:460px; width:100%;">
        <div class="auth__brand">
          <div class="brand__logo">SP</div>
          <div>
            <div class="auth__title">SSR Sign In</div>
            <div class="muted">Same Sprinto design language, server-rendered.</div>
          </div>
        </div>

        <% if (error) { %>
          <div class="badge badge--danger" style="display:inline-block; margin: 0 0 14px;"><%= error %></div>
        <% } %>

        <form id="ssrLoginForm" class="grid">
          <div class="field">
            <div class="label">Email</div>
            <input class="input" name="email" type="email" value="alex@company.com" required />
          </div>
          <div class="field">
            <div class="label">Password</div>
            <input class="input" name="password" type="password" value="admin123" required />
          </div>
          <button class="btn btn--primary" type="submit">Sign In</button>
        </form>

        <div class="muted" style="margin-top:14px;">
          Demo accounts: <code>alex@company.com / admin123</code> and <code>demo@sprinto.dev / demo123</code>
        </div>
        <div class="row" style="margin-top:14px;">
          <a class="btn btn--ghost" href="/">Open SPA</a>
        </div>
      </section>
    </main>

    <script>
      document.getElementById("ssrLoginForm").addEventListener("submit", async function (event) {
        event.preventDefault();

        const form = new FormData(event.target);
        const response = await fetch("/api/auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: form.get("email"),
            password: form.get("password"),
          }),
        });

        if (response.ok) {
          window.location.href = "/dashboard";
          return;
        }

        const payload = await response.json().catch(() => ({ message: "Unable to log in" }));
        window.alert(payload.message || "Unable to log in");
      });
    </script>
  </body>
</html>
