<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/styles.css" />
    <script src="/socket.io/socket.io.js"></script>
  </head>
  <body>
    <main class="main">
      <header class="topbar">
        <div>
          <div class="muted">SSR Sprint View</div>
          <div class="crumb"><%= sprint.name %></div>
        </div>
        <div class="row">
          <a class="btn btn--ghost" href="/dashboard">Dashboard</a>
          <a class="btn btn--primary" href="/">SPA Board</a>
        </div>
      </header>

      <section class="content">
        <section class="card">
          <div class="row">
            <span class="badge badge--<%= sprint.status === 'active' ? 'active' : sprint.status === 'completed' ? 'completed' : 'planned' %>"><%= sprint.status %></span>
            <span class="chip">Signed in as <%= user.name %></span>
          </div>
          <p class="muted" style="margin-bottom:0;"><%= sprint.goal || "No sprint goal" %></p>
        </section>

        <section class="card" style="margin-top: 16px;">
          <h3 class="card__title">Sprint Issues</h3>
          <div id="ssrUpdates" class="muted" style="margin-bottom: 12px;">Listening for board updates...</div>
          <div class="grid grid--2">
            <% issues.forEach(function (issue) { %>
              <article class="issue">
                <div class="issue__title"><%= issue.title %></div>
                <div class="issue__desc muted"><%= issue.description || "No description" %></div>
                <div class="issue__meta">
                  <span class="badge badge--outline">Status</span>
                  <span class="badge badge--planned"><%= issue.status %></span>
                </div>
              </article>
            <% }) %>
            <% if (!issues.length) { %>
              <div class="muted">No issues assigned to this sprint.</div>
            <% } %>
          </div>
        </section>
      </section>
    </main>

    <script>
      const socket = window.io();
      socket.emit("joinBoard", "<%= sprint.id %>");
      socket.on("updateBoard", function (payload) {
        if (payload && payload.sprintId === "<%= sprint.id %>") {
          document.getElementById("ssrUpdates").textContent =
            "Real-time update received for issue " + payload.issueId + " -> " + payload.status;
        }
      });
    </script>
  </body>
</html>
